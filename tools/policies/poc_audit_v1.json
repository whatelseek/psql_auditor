{
  "version": "1.0.0",
  "profile": "poc_audit_v1",
  "description": "POC capability policy: SSH tools authorized; ssh_allow_all_commands=true (lab) skips SSH command allow-list.",
  "readonly_required": true,
  "allowed_tools": [
    "ssh_run",
    "ssh_read_file"
  ],
  "denied_tools": [],
  "allowed_transports": [
    "ssh"
  ],
  "max_output_chars": 6000,
  "require_inventory_credentials": true,
  "ssh_allowed_commands": [
    "blkid",
    "cat /etc/os-release",
    "cat /proc/cpuinfo",
    "cat /proc/loadavg",
    "cat /proc/meminfo",
    "cat /proc/uptime",
    "cat /proc/version",
    "command -v postgres",
    "command -v psql",
    "command -v smartctl",
    "df -h",
    "dpkg -l",
    "dpkg-query -W",
    "free -h",
    "free -m",
    "hostname",
    "hostname -f",
    "hostname -s",
    "hostnamectl",
    "hostnamectl status",
    "id",
    "ls -ld /etc/postgresql",
    "ls -ld /var/lib/pgsql",
    "ls -ld /var/lib/postgresql",
    "lsblk",
    "lsblk -f",
    "lscpu",
    "netstat -lntp",
    "netstat -lntup",
    "netstat -tuln",
    "netstat -tulpen",
    "postgres --version",
    "ps -ef",
    "ps aux",
    "psql --version",
    "rpm -qa",
    "ss -lnt",
    "ss -lntp",
    "ss -lntup",
    "ss -tuln",
    "ss -tulpen",
    "systemctl list-units --type=service --all",
    "systemctl list-units --type=service --all --no-pager",
    "systemctl list-units --type=service --state=running",
    "systemctl list-units --type=service --state=running --no-pager",
    "uname -a",
    "uname -m",
    "uname -r",
    "uptime",
    "which smartctl",
    "who -b",
    "whoami"
  ],
  "ssh_allowed_command_patterns": [
    "^sysctl\\s+[A-Za-z0-9._*-]+$",
    "^getent\\s+(passwd|group)\\s+[A-Za-z0-9._-]+$",
    "^systemctl\\s+status\\s+[A-Za-z0-9@._:-]+(?:\\s+--no-pager)?$",
    "^systemctl\\s+is-active\\s+[A-Za-z0-9@._:-]+$",
    "^systemctl\\s+is-enabled\\s+[A-Za-z0-9@._:-]+$",
    "^ls\\s+-l[aAd]*\\s+/etc/postgresql(?:/[A-Za-z0-9._/-]+)?$",
    "^ls\\s+-l[aAd]*\\s+/var/lib/postgresql(?:/[A-Za-z0-9._/-]+)?$",
    "^ls\\s+-l[aAd]*\\s+/var/lib/pgsql(?:/[A-Za-z0-9._/-]+)?$",
    "^stat\\s+/etc/postgresql(?:/[A-Za-z0-9._/-]+)?$",
    "^stat\\s+/var/lib/postgresql(?:/[A-Za-z0-9._/-]+)?$",
    "^stat\\s+/etc/os-release$",
    "^readlink\\s+-f\\s+/etc/postgresql(?:/[A-Za-z0-9._/-]+)?$",
    "^dpkg-query\\s+-W(?:\\s+[A-Za-z0-9._+-]+)?$",
    "^rpm\\s+-q\\s+[A-Za-z0-9._+-]+$",
    "^lsblk(?:\\s+-[a-zA-Z]+)*(?:\\s+-o\\s+[A-Za-z0-9,]+)?$",
    "^ss\\s+-[a-z]+$",
    "^netstat\\s+-[a-z]+$",
    "^command\\s+-v\\s+[A-Za-z0-9._+-]+$",
    "^which\\s+[A-Za-z0-9._+-]+$",
    "^smartctl\\s+-H\\s+/dev/[A-Za-z0-9]+$",
    "^smartctl\\s+-i\\s+/dev/[A-Za-z0-9]+$"
  ],
  "ssh_allow_all_commands": true
}
