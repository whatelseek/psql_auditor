{
  "id": "http_get",
  "version": "1.0.0",
  "title": "HTTP GET/HEAD",
  "description": "Read-only HTTP GET or HEAD against an inventory host.",
  "transport": "http",
  "adapter": "auditor.tools.http_get:invoke_http_get",
  "capabilities": ["http.get"],
  "risk": "low",
  "readonly": true,
  "inventory_access": ["http", "https"],
  "credential_source": "none",
  "blocked_operations": ["http_write", "credential_url", "cross_host_redirect"],
  "timeout_seconds": 10,
  "max_output_bytes": 16384,
  "enabled": true,
  "profiles": ["poc_audit_v1"],
  "input_schema": {
    "type": "object",
    "properties": {
      "scheme": {"type": "string", "enum": ["http", "https"]},
      "port": {"type": "integer", "minimum": 1, "maximum": 65535},
      "path": {"type": "string"},
      "method": {"type": "string", "enum": ["GET", "HEAD"]}
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status": {"type": "string"},
      "output": {"type": "string"}
    }
  }
}
