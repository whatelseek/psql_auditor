# Host port for the MLflow UI / tracking API
MLFLOW_HOST_PORT=5000

# Official image (pin for reproducibility)
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.1.4

MLFLOW_CONTAINER_NAME=psql-auditor-mlflow

# Persistence under ./data (mounted at /mlflow/data)
MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/data/mlflow.db
MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/data/artifacts
