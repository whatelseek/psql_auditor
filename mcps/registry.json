{
  "version": 1,
  "mcpServers": {
    "postgres": {
      "enabled": true,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-postgres-server"],
      "envFrom": "inventory:pg",
      "frameworks": ["postgres_cis"],
      "curatedTools": true,
      "blockedTools": ["execute"],
      "description": "PostgreSQL read-only evidence via antonorlov/mcp-postgres-server"
    },
    "microsoft-learn": {
      "enabled": true,
      "transport": "streamable_http",
      "url": "https://learn.microsoft.com/api/mcp",
      "frameworks": [],
      "curatedTools": true,
      "description": "Official Microsoft Learn docs/code search (no auth) for how-to guidance"
    }
  }
}
