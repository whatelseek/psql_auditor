# LiteLLM (agent → model gateway)
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-litellm-local
LITELLM_MODEL=gpt-4o-mini

# Backend provider key consumed by LiteLLM proxy
OPENAI_API_KEY=sk-your-openai-key

# Optional gate for the agent OpenAI-compatible API
API_KEY=sk-auditor-local

# Checklist
CHECKLIST_PATH=checklists/postgres_cis.md

# SSH target (PostgreSQL host)
SSH_HOST=
SSH_PORT=22
SSH_USER=postgres
SSH_PRIVATE_KEY_PATH=
SSH_PASSWORD=
SSH_CONNECT_TIMEOUT=15

# Direct PostgreSQL (SQL tools)
DATABASE_URL=
# Or discrete:
PG_HOST=
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=postgres

# Optional Postgres MCP server (stdio or SSE URL)
MCP_POSTGRES_URL=
MCP_POSTGRES_COMMAND=
MCP_POSTGRES_ARGS=

# Agent API
HOST=0.0.0.0
PORT=8000
MODEL_ID=psql-auditor
