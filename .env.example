# LiteLLM (agent → model gateway)
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-litellm-local
LITELLM_MODEL=gpt-4o-mini

# Backend provider key consumed by LiteLLM proxy
OPENAI_API_KEY=sk-your-openai-key

# Optional gate for the agent OpenAI-compatible API
API_KEY=sk-auditor-local

# Drop-in frameworks directory (you create *.md here)
AGENTS_DIR=agents
# Long-term procedural memory (command playbooks)
# Seeds: PLAYBOOKS_DIR YAML. Learned recipes → results-db playbook_memory
# (when RESULTS_DB_ENABLED); else MEMORY_DIR/learned_playbooks.json
PLAYBOOKS_DIR=agents/playbooks
MEMORY_DIR=memory
MEMORY_ENABLED=true
MEMORY_LEARN=true
# Per-run evidence root: <EVIDENCE_DIR>/<run_id>/<framework>/REQ-NNN/
EVIDENCE_DIR=artifacts
# Durable LangGraph checkpoints (survives agent container restart)
CHECKPOINT_PATH=artifacts/.checkpoints/auditor.sqlite
# Pause on failed REQs and ask skip / retry in Open WebUI chat
HITL_ENABLED=false
# Zip report+evidence after audit and link it in chat
ARCHIVE_ENABLED=true
# Browser-reachable agent URL (markdown Download ZIP links)
PUBLIC_BASE_URL=http://localhost:8000
# Internal Open WebUI URL for uploading the zip into the UI file store
OPEN_WEBUI_URL=http://open-webui:8080
# Optional public Open WebUI URL for absolute file links
OPEN_WEBUI_PUBLIC_URL=http://localhost:3000
# Bearer token if Open WebUI auth / API keys are enabled
OPEN_WEBUI_API_KEY=
# Fallback: sign in for file upload when API key is empty (lab defaults)
OPEN_WEBUI_EMAIL=admin@localhost
OPEN_WEBUI_PASSWORD=admin
# Cyclic reconnect attempts when MCP/SSH session dies mid-audit
MAX_SESSION_RETRIES=2

# SSH / PostgreSQL / NetBox / MCP connection credentials live ONLY under secrets/:
#   cp secrets/connection.example.md secrets/connection.md
# Do not put SSH_*, PG_*, DATABASE_URL, NETBOX_*, or MCP_* in docker-compose.yml.
SECRETS_DIR=secrets
INTAKE_ENABLED=true
INVENTORY_DIR=inventory

# Context / parallelism
MAX_TOOL_ROUNDS_PER_ITEM=4
MAX_TOOL_OUTPUT_CHARS=6000
MAX_FINDING_EVIDENCE_CHARS=2500
MAX_USER_REQUEST_CHARS=1500
MAX_FINALIZE_EVIDENCE_CHARS=240
MAX_PARALLEL_ASSESSMENTS=5
# Concurrent host/framework audit graphs (different hosts; same host exclusive)
MAX_PARALLEL_HOST_JOBS=2
# Concurrent Postgres MCP stdio workers (parallel mcp_query); each spawns npx
MCP_POSTGRES_POOL_SIZE=3

COMPLIANCE_CHARTS_IN_REPORT=true

# Ad-hoc command execution from chat (SSH/SQL/playbook without full audit)
ADHOC_COMMANDS_ENABLED=true

# Results warehouse (filled checklist cells). Separate from audit-target PG_* /
# DATABASE_URL. Evidence files stay on disk under artifacts/.
# Results warehouse Postgres (docker compose service: results-db)
RESULTS_DB_ENABLED=true
RESULTS_DB_USER=results_admin
RESULTS_DB_PASSWORD=results_lab_secret
RESULTS_DB_NAME=postgres
RESULTS_DATABASE_URL=postgresql://results_admin:results_lab_secret@results-db:5432/postgres
RESULTS_DB_PER_CLIENT=true
RESULTS_DB_NAME_PREFIX=results_

# Optional MLflow tracking (standalone stack: mlflow/scripts/start.sh).
# Drop anytime: MLFLOW_ENABLED=false and mlflow/scripts/stop.sh — audits unchanged.
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=http://host.docker.internal:5000
MLFLOW_EXPERIMENT_NAME=psql-auditor
MLFLOW_AUTOLOG=true

HOST=0.0.0.0
PORT=8000
MODEL_ID=auditor
