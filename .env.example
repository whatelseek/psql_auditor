# LiteLLM (agent → model gateway)
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-litellm-local
LITELLM_MODEL=gpt-4o-mini

# Backend provider key consumed by LiteLLM proxy
OPENAI_API_KEY=sk-your-openai-key

# Optional gate for the agent OpenAI-compatible API
API_KEY=sk-auditor-local

# Checklist
CHECKLIST_PATH=checklists/postgres_cis.md

# SSH target (PostgreSQL host)
SSH_HOST=
SSH_PORT=22
SSH_USER=postgres
SSH_PRIVATE_KEY_PATH=
SSH_PASSWORD=
SSH_CONNECT_TIMEOUT=15

# PostgreSQL credentials for antonorlov/mcp-postgres-server
# (https://github.com/antonorlov/mcp-postgres-server)
# Either DATABASE_URL or discrete PG_* fields:
DATABASE_URL=
PG_HOST=your-postgres-host
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-password
PG_DATABASE=postgres

# MCP stdio launcher (defaults target antonorlov's npm package)
MCP_POSTGRES_COMMAND=npx
MCP_POSTGRES_ARGS=-y mcp-postgres-server

# Agent API
HOST=0.0.0.0
PORT=8000
MODEL_ID=psql-auditor
